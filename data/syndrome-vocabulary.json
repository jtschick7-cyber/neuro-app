{
  "vocabulary": [
    {"id": "limbic-encephalitis", "label": "Limbic encephalitis", "definition": "Subacute memory loss, temporal seizures, psychiatric change with mesial temporal involvement"},
    {"id": "encephalitis-diffuse", "label": "Autoimmune encephalitis / encephalopathy (diffuse or multifocal)", "definition": "Non-limbic or multifocal encephalitis/encephalopathy, incl. anti-NMDAR encephalitis and ADEM-like cortical syndromes"},
    {"id": "meningoencephalitis", "label": "Meningoencephalitis / meningoencephalomyelitis", "definition": "Meningeal involvement with encephalitis and/or myelitis"},
    {"id": "cognitive-decline", "label": "Subacute cognitive decline / rapidly progressive dementia", "definition": "Cognitive impairment or dementia without full encephalitis criteria; CJD and neurodegenerative mimics"},
    {"id": "psychiatric", "label": "Psychiatric presentation", "definition": "Psychosis, catatonia, mood or behavioral change as a leading feature"},
    {"id": "seizures", "label": "Epilepsy / seizures", "definition": "Seizures, status epilepticus, faciobrachial dystonic seizures, chronic autoimmune epilepsy"},
    {"id": "brainstem", "label": "Brainstem syndrome / rhombencephalitis", "definition": "Brainstem encephalitis, bulbar syndrome, area postrema syndrome, eye-movement disorders of brainstem origin"},
    {"id": "diencephalic", "label": "Diencephalic / hypothalamic syndrome", "definition": "Hypothalamic dysfunction, hypersomnia/narcolepsy of diencephalic origin, endocrine disturbance"},
    {"id": "cerebellar-ataxia", "label": "Cerebellar ataxia / cerebellar syndrome", "definition": "Subacute or progressive cerebellar syndrome, incl. rhombencephalitis with ataxia"},
    {"id": "opsoclonus-myoclonus", "label": "Opsoclonus-myoclonus", "definition": "Opsoclonus-myoclonus syndrome"},
    {"id": "stiff-person-spectrum", "label": "Stiff-person spectrum / CNS hyperexcitability", "definition": "SPS, PERM, hyperekplexia and related brainstem/spinal hyperexcitability"},
    {"id": "movement-disorder", "label": "Movement disorder (non-ataxic)", "definition": "Chorea, dystonia, dyskinesia, parkinsonism, PSP-like, myoclonus, tremor"},
    {"id": "sleep-disorder", "label": "Sleep disorder", "definition": "Parasomnia, sleep-breathing disorder, insomnia, hypersomnia"},
    {"id": "encephalomyelitis", "label": "Encephalomyelitis", "definition": "Multifocal CNS (± PNS) involvement, incl. paraneoplastic encephalomyelitis, PERM, ADEM"},
    {"id": "myelopathy", "label": "Myelopathy / myelitis", "definition": "Myelitis, tractopathy, longitudinally extensive cord lesions, myeloneuropathy"},
    {"id": "optic-neuropathy", "label": "Optic neuritis / optic neuropathy / retinopathy", "definition": "Optic neuritis, papillitis, optic neuropathy, chorioretinopathy"},
    {"id": "sensory-neuronopathy", "label": "Sensory neuronopathy", "definition": "Dorsal root ganglionopathy with sensory ataxia"},
    {"id": "neuropathy", "label": "Peripheral neuropathy / polyradiculoneuropathy", "definition": "Sensorimotor, small-fiber or large-fiber neuropathy; polyradiculoneuropathy"},
    {"id": "autonomic", "label": "Autonomic dysfunction / GI dysmotility", "definition": "Dysautonomia, GI pseudo-obstruction, gastroparesis, diarrhea prodrome"},
    {"id": "neuromuscular-junction", "label": "Lambert-Eaton / neuromuscular junction", "definition": "LEMS and other neuromuscular junction disorders"},
    {"id": "nerve-hyperexcitability", "label": "Peripheral nerve hyperexcitability / Morvan", "definition": "Acquired neuromyotonia, Morvan syndrome"},
    {"id": "post-ici", "label": "Onset after immune checkpoint inhibitor treatment", "definition": "Neurologic syndrome appearing or worsening during or after immune checkpoint inhibitor cancer therapy"}
  ],
