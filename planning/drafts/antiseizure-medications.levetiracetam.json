  "hepatic": [
    "No adjustment: mild–moderate PK unchanged; severe (Child-Pugh C) clearance ↓50%, mostly from reduced renal clearance (§12.3)"
  ],
  "ivPo": [
    "IV ↔ PO 1:1: same total daily dose and frequency in both directions (§2.4–2.5)",
    "IV: dilute in 100 mL NS, LR or D5W; give over 15 min (§2.6)",
    "No clinical study experience with IV levetiracetam beyond 4 days (§2.1)"
  ],
  "enteral": [
    "Tube administration not addressed in label — confirm with pharmacy"
  ],
