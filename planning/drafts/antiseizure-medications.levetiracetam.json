  "interactions": [
    "Unlikely to cause or be subject to PK interactions; not CYP450-dependent (§12.3)"
  ],
  "pearls": [
    "Avoid abrupt withdrawal — risk of increased seizures and status epilepticus (§2.8)",
    "Elderly: renally cleared — dose by renal function (§8.5)"
