{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "VASCULAR",
              "SEIZURE",
              "COGNITION_ENCEPHALOPATHY",
              "NEUROMUSCULAR",
              "SPINAL",
              "NEURO_OPHTH_VESTIBULAR",
              "HEADACHE",
              "INFLAMMATORY_DEMYELINATING",
              "PROGNOSIS_DEATH",
              "FUNCTIONAL"
            ]
          },
          "consultQuestion": {
            "type": "string",
            "minLength": 1
          },
          "keyHistory": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keyExam": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "redFlags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "differential": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dx": {
                  "type": "string",
                  "minLength": 1
                },
                "clues": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mustNotMiss": {
                  "type": "boolean"
                }
              },
              "required": [
                "dx",
                "clues",
                "mustNotMiss"
              ],
              "additionalProperties": false
            }
          },
          "workup": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "STAT",
                    "URGENT",
                    "ROUTINE",
                    "IF_INDICATED"
                  ]
                },
                "indication": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "test",
                "priority",
                "indication",
                "notes"
              ],
              "additionalProperties": false
            }
          },
          "decisionRules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceLevel": {
                  "type": "string",
                  "enum": [
                    "STRONG",
                    "MODERATE",
                    "WEAK",
                    "CONSENSUS",
                    "EXPERT_OPINION",
                    "NOT_GRADED"
                  ]
                },
                "evidenceNote": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "order",
                "condition",
                "recommendation",
                "evidenceLevel",
                "evidenceNote"
              ],
              "additionalProperties": false
            }
          },
          "initialSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "calculatorIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "institutionVaries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pearls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relatedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lastReviewed": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              {
                "type": "string",
                "const": "UNREVIEWED"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "searchTerms",
          "category",
          "consultQuestion",
          "keyHistory",
          "keyExam",
          "redFlags",
          "differential",
          "workup",
          "decisionRules",
          "initialSteps",
          "disposition",
          "calculatorIds",
          "institutionVaries",
          "pearls",
          "verify",
          "relatedIds",
          "sources",
          "lastReviewed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "version",
    "schemaVersion",
    "lastUpdated",
    "entries"
  ],
  "additionalProperties": false
}
