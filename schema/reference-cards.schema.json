{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scopeNote": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rows": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "parameter": {
                            "type": "string",
                            "minLength": 1
                          },
                          "condition": {
                            "type": "string",
                            "minLength": 1
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "TARGET",
                              "RECOMMENDED",
                              "NOT_RECOMMENDED",
                              "EVIDENCE_SUMMARY"
                            ]
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1
                          },
                          "notes": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "evidenceLevel": {
                            "type": "string",
                            "enum": [
                              "STRONG",
                              "MODERATE",
                              "WEAK",
                              "CONSENSUS",
                              "EXPERT_OPINION",
                              "NOT_GRADED"
                            ]
                          },
                          "evidenceNote": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "sources": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "parameter",
                          "condition",
                          "role",
                          "target",
                          "notes",
                          "evidenceLevel",
                          "evidenceNote",
                          "sources"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "heading",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "MATRIX"
                    },
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "columns": {
                      "minItems": 2,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "key",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "rows": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "test": {
                            "type": "string",
                            "minLength": 1
                          },
                          "cells": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "column": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "VALID",
                                    "CAUTION",
                                    "UNRELIABLE",
                                    "ASSAY_DEPENDENT",
                                    "NOT_ADDRESSED"
                                  ]
                                },
                                "direction": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "FALSE_LOW",
                                        "FALSE_HIGH",
                                        "EITHER"
                                      ]
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "evidenceLevel": {
                                  "type": "string",
                                  "enum": [
                                    "STRONG",
                                    "MODERATE",
                                    "WEAK",
                                    "CONSENSUS",
                                    "EXPERT_OPINION",
                                    "NOT_GRADED"
                                  ]
                                },
                                "evidenceNote": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "sources": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                }
                              },
                              "required": [
                                "column",
                                "status",
                                "direction",
                                "text",
                                "evidenceLevel",
                                "evidenceNote",
                                "sources"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "notes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "evidenceLevel": {
                                  "type": "string",
                                  "enum": [
                                    "STRONG",
                                    "MODERATE",
                                    "WEAK",
                                    "CONSENSUS",
                                    "EXPERT_OPINION",
                                    "NOT_GRADED"
                                  ]
                                },
                                "evidenceNote": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "sources": {
                                  "minItems": 1,
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                }
                              },
                              "required": [
                                "text",
                                "evidenceLevel",
                                "evidenceNote",
                                "sources"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "test",
                          "cells",
                          "notes"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "heading",
                    "columns",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "pitfalls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keyNumbers": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relatedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lastReviewed": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              {
                "type": "string",
                "const": "UNREVIEWED"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "searchTerms",
          "scopeNote",
          "sections",
          "pitfalls",
          "keyNumbers",
          "verify",
          "relatedIds",
          "sources",
          "lastReviewed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "version",
    "schemaVersion",
    "lastUpdated",
    "entries"
  ],
  "additionalProperties": false
}
