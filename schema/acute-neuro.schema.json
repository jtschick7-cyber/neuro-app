{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "SEIZURE",
              "NEUROMUSCULAR",
              "NEUROIMMUNOLOGY",
              "CNS_INFECTION",
              "SPINAL",
              "ICP_HERNIATION",
              "TOXIC_METABOLIC",
              "ENCEPHALOPATHY",
              "HEADACHE"
            ]
          },
          "keyNumbers": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "presentation": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definitions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "immediateActions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "window": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "order",
                "window",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "workup": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "STAT",
                    "URGENT",
                    "ROUTINE",
                    "IF_INDICATED"
                  ]
                },
                "indication": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "test",
                "priority",
                "indication",
                "notes"
              ],
              "additionalProperties": false
            }
          },
          "treatment": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "FIRST_LINE",
                    "SECOND_LINE",
                    "THIRD_LINE",
                    "ALTERNATIVE",
                    "ADJUNCT",
                    "SUPPORTIVE",
                    "NOT_RECOMMENDED"
                  ]
                },
                "agent": {
                  "type": "string",
                  "minLength": 1
                },
                "routes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "IV",
                      "IM",
                      "IO",
                      "PO",
                      "NG",
                      "SC",
                      "IN",
                      "BUCCAL",
                      "PR",
                      "INTRATHECAL",
                      "NON_PHARM",
                      "EPIDURAL",
                      "PERINEURAL"
                    ]
                  }
                },
                "doseText": {
                  "type": "string",
                  "minLength": 1
                },
                "dose": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "amountMin": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "amountMax": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "MG",
                          "G",
                          "MCG",
                          "MG_PE",
                          "UNITS",
                          "ML",
                          "MEQ",
                          "MMOL"
                        ]
                      },
                      "basis": {
                        "type": "string",
                        "enum": [
                          "FIXED",
                          "PER_KG"
                        ]
                      },
                      "timing": {
                        "type": "string",
                        "enum": [
                          "SINGLE",
                          "PER_DOSE",
                          "PER_HOUR",
                          "PER_MIN",
                          "PER_DAY"
                        ]
                      },
                      "weightBasis": {
                        "type": "string",
                        "enum": [
                          "ACTUAL",
                          "IDEAL",
                          "ADJUSTED",
                          "NOT_APPLICABLE"
                        ]
                      },
                      "caps": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "amount": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "unit": {
                              "type": "string",
                              "enum": [
                                "MG",
                                "G",
                                "MCG",
                                "MG_PE",
                                "UNITS",
                                "ML",
                                "MEQ",
                                "MMOL"
                              ]
                            },
                            "scope": {
                              "type": "string",
                              "enum": [
                                "PER_DOSE",
                                "PER_DAY",
                                "PER_COURSE",
                                "MAX_RATE_PER_MIN"
                              ]
                            }
                          },
                          "required": [
                            "amount",
                            "unit",
                            "scope"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "frequency": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "duration": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "label",
                      "amountMin",
                      "amountMax",
                      "unit",
                      "basis",
                      "timing",
                      "weightBasis",
                      "caps",
                      "frequency",
                      "duration"
                    ],
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidenceLevel": {
                  "type": "string",
                  "enum": [
                    "STRONG",
                    "MODERATE",
                    "WEAK",
                    "CONSENSUS",
                    "EXPERT_OPINION",
                    "NOT_GRADED"
                  ]
                },
                "evidenceNote": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "formularyStatus": {
                  "type": "string",
                  "enum": [
                    "LOCAL_PREFERRED",
                    "AVAILABLE",
                    "NOT_STOCKED_LOCAL",
                    "INSTITUTION_VARIES"
                  ]
                },
                "calculatorIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "role",
                "agent",
                "routes",
                "doseText",
                "dose",
                "notes",
                "evidenceLevel",
                "evidenceNote",
                "formularyStatus",
                "calculatorIds"
              ],
              "additionalProperties": false
            }
          },
          "pitfalls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "escalateWhen": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "institutionVaries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relatedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lastReviewed": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              {
                "type": "string",
                "const": "UNREVIEWED"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "searchTerms",
          "presentation",
          "definitions",
          "immediateActions",
          "workup",
          "treatment",
          "pitfalls",
          "escalateWhen",
          "institutionVaries",
          "verify",
          "relatedIds",
          "sources",
          "lastReviewed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "version",
    "schemaVersion",
    "lastUpdated",
    "entries"
  ],
  "additionalProperties": false
}
